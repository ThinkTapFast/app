# Database - Neon Postgres with Connection Pooling
# Replace with your actual Neon connection strings
# Pooled connection (for app runtime) - includes -pooler in hostname
DATABASE_URL="postgresql://username:password@ep-your-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=15&connection_limit=20&pool_timeout=15"
# Direct connection (for migrations) - without -pooler
DIRECT_URL="postgresql://username:password@ep-your-endpoint.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=15"

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication - User Management & Authentication
# Get these keys from: https://dashboard.clerk.com/
# 1. Create a Clerk application
# 2. Go to API Keys section
# 3. Copy the keys below

# Public key - Safe to expose in browser (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key - Server-side only, NEVER expose in browser (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk URLs - Authentication flow configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Clerk Webhook Configuration (for user sync)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Paddle Payment Integration - Subscription Management
# Get these keys from: https://vendors.paddle.com/authentication-v2
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_SIDE_TOKEN=