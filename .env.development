# Database - Neon Postgres with Connection Pooling
# Replace with your actual Neon connection strings
# Pooled connection (for app runtime) - includes -pooler in hostname
DATABASE_URL="postgresql://username:password@ep-your-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=15&connection_limit=20&pool_timeout=15"
# Direct connection (for migrations) - without -pooler
DIRECT_URL="postgresql://username:password@ep-your-endpoint.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=15"
