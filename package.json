{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "db:generate": "dotenv -e .env.development.local -- prisma generate",
    "db:push": "dotenv -e .env.development.local -- prisma db push",
    "db:migrate": "dotenv -e .env.development.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.development.local -- prisma studio",
    "db:seed": "dotenv -e .env.development.local -- tsx server/db/seeds.ts",
    "db:seed:permissions": "dotenv -e .env.development.local -- tsx server/db/seed-permissions-only.ts",
    "db:reset": "dotenv -e .env.development.local -- prisma migrate reset && bun run db:seed",
    "db:setup": "bun run db:generate && bun run db:push && bun run db:seed",
    "db:clean": "dotenv -e .env.development.local -- prisma db push --force-reset && bun run db:seed",
    "db:nuke": "dotenv -e .env.development.local -- tsx server/db/clean.ts",
    "db:generate:prod": "dotenv -e .env.production.local -- prisma generate",
    "db:push:prod": "dotenv -e .env.production.local -- prisma db push",
    "db:migrate:deploy": "dotenv -e .env.production.local -- prisma migrate deploy",
    "db:studio:prod": "dotenv -e .env.production.local -- prisma studio",
    "db:seed:prod": "dotenv -e .env.production.local -- tsx server/db/seeds.ts",
    "db:seed:permissions:prod": "dotenv -e .env.production.local -- tsx server/db/seed-permissions-only.ts",
    "db:reset:prod": "dotenv -e .env.production.local -- prisma migrate reset && bun run db:seed:prod",
    "db:setup:prod": "bun run db:generate:prod && bun run db:push:prod && bun run db:seed:prod",
    "db:clean:prod": "dotenv -e .env.production.local -- prisma db push --force-reset && bun run db:seed:prod",
    "db:nuke:prod": "dotenv -e .env.production.local -- tsx server/db/clean-prod.ts",
    "docker:build": "docker build -t thinktapfast-app .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production.local thinktapfast-app",
    "docker:build:dev": "docker build -t thinktapfast-app-dev -f Dockerfile.dev .",
    "docker:run:dev:cmd": "docker run -p 3000:3000 --env-file .env.development.local -v %cd%:/app -v /app/node_modules thinktapfast-app-dev",
    "docker:run:dev:powershell": "powershell -ExecutionPolicy Bypass -File scripts/docker-dev.ps1",
    "docker:run:dev:mac": "bash scripts/docker-dev.sh",
    "docker:run:dev:linux": "bash scripts/docker-dev.sh"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.9",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/adapter-neon": "^6.15.0",
    "@prisma/client": "^6.15.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "svix": "^1.76.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.5",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}
